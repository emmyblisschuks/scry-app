# Supabase (safe to expose client-side — anon key is public by design)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — set these as Supabase Edge Function secrets, NOT here,
# and never commit real values. This file is a reference for what the
# functions expect, not where the real keys live.
#
#   supabase secrets set SUPABASE_URL=https://your-project-ref.supabase.co
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
